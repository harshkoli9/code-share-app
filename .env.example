PORT=5051
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/codeshare
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
SERVE_CLIENT=true

# Password recovery email (Resend). Leave blank to disable password recovery.
# Use a verified sender address from your Resend account.
RESEND_API_KEY=
EMAIL_FROM=CodeShare <no-reply@example.com>
FRONTEND_URL=http://localhost:5173

# Leave empty when using the local Vite proxy. Set to the deployed API origin
# when building the GitHub Pages frontend.
VITE_API_BASE=

# Used only by npm run migrate:firebase. A database admin token is optional
# when the Firebase Realtime Database permits public reads.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_AUTH_TOKEN=
